{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statuszero",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATUS_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
